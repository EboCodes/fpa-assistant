# AI Service Environment Configuration

# Server
AI_SERVICE_PORT=5001
DEBUG=False

# Backend API
BACKEND_URL=http://localhost:5000

# LLM Configuration
LLM_PROVIDER=gemini  # Options: gemini, openai, huggingface, local
OPENAI_API_KEY=your_openai_api_key
GOOGLE_API_KEY=your_google_api_key
LLM_MODEL=models/gemini-3.6-flash
TEMPERATURE=0.7

# Database (if needed for caching)
DATABASE_URL=postgresql://user:password@localhost:5432/educational_assistant

# NLP Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2  # SentenceTransformer model
SPACY_MODEL=en_core_web_sm

# Logging
LOG_LEVEL=INFO
